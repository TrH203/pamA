# --- Required -------------------------------------------------------------------------------
# Public address of this server (used in Ask Link and sign-in URLs). Put TLS in front of it.
PAMA_BASE_URL=https://pama.example.com
# The only email allowed to sign in to the console (self-host).
PAMA_OWNER_EMAIL=you@example.com
# 32+ random characters each: `openssl rand -base64 36`
PAMA_SECRET=change-me-to-32-or-more-random-characters
PAMA_OWNER_TOKEN=change-me-to-another-long-random-token
POSTGRES_PASSWORD=change-me-postgres
PAMA_DB_PASSWORD=change-me-server-db

# --- Email (sign-in links, one-time codes, owner replies) -------------------------------------
# Without SMTP, sign in with PAMA_OWNER_TOKEN and use open or PIN links only.
SMTP_URL=smtp://user:password@smtp.example.com:587
SMTP_FROM=pamA <pama@example.com>

# --- Models ------------------------------------------------------------------------------------
# Anthropic for answers, a local or hosted embedding model (Anthropic has no embeddings API).
PAMA_CHAT_PROVIDER=anthropic
PAMA_CHAT_MODEL=claude-sonnet-5-5
PAMA_SMALL_MODEL=claude-haiku-5-5
PAMA_CHAT_API_KEY=
PAMA_EMBED_PROVIDER=ollama
PAMA_EMBED_MODEL=bge-m3
PAMA_EMBED_BASE_URL=http://ollama:11434
# Fully self-hosted alternative: PAMA_CHAT_PROVIDER=openai-compatible, PAMA_CHAT_BASE_URL=http://vllm:8000/v1

# --- Optional ------------------------------------------------------------------------------------
# Publish on all interfaces instead of localhost only (put a TLS reverse proxy in front):
# PAMA_PUBLISH=0.0.0.0:7465
# Block every outbound connection except these hosts:
# PAMA_STRICT_OFFLINE=true
# PAMA_DECLARED_HOSTS=api.anthropic.com,ollama,smtp.example.com
