# pamA Cloud on one VM: `cp deploy/cloud/.env.example deploy/cloud/.env`, then fill in.
# Generate each secret with: openssl rand -base64 36

# --- Address ------------------------------------------------------------------------------------
# Both names must resolve to the VM's static IP before the first start. Without a domain, use
# sslip.io: for IP 13.212.5.9 set app.13-212-5-9.sslip.io and 13-212-5-9.sslip.io.
# Console, API and Ask Links:
PAMA_DOMAIN=app.example.com
# Landing page (landing/index.html):
PAMA_LANDING_DOMAIN=example.com
# Server image; pin a release tag (rollback = set the previous tag and `up -d` again).
PAMA_IMAGE=ghcr.io/trh203/pama/server:latest

# --- Secrets ------------------------------------------------------------------------------------
# Keep a copy outside the VM: without PAMA_SECRET, stored model keys cannot be decrypted.
PAMA_SECRET=
# Operator credential (server-wide models, default workspace). Never give it to owners.
PAMA_OWNER_TOKEN=
POSTGRES_PASSWORD=
PAMA_DB_PASSWORD=
# Leave unset in cloud mode: every email can sign up and gets its own workspace.
# (An empty value fails validation; keep the line commented.)
# PAMA_OWNER_EMAIL=

# --- Email (required in cloud mode: sign-in is by email link) ------------------------------------
SMTP_URL=smtp://user:password@email-smtp.ap-southeast-1.amazonaws.com:587
SMTP_FROM=pamA <no-reply@example.com>

# --- Answering models (operator defaults; workspaces may bring their own chat key) ----------------
PAMA_CHAT_PROVIDER=anthropic
PAMA_CHAT_MODEL=claude-sonnet-5-5
PAMA_SMALL_MODEL=claude-haiku-5-5
PAMA_CHAT_API_KEY=

# --- Embeddings over an API (must return 1024-dimension vectors) ---------------------------------
# bge-m3 is the same model local and self-hosted servers use through Ollama.
PAMA_EMBED_PROVIDER=openai-compatible
PAMA_EMBED_BASE_URL=https://api.deepinfra.com/v1/openai
PAMA_EMBED_MODEL=BAAI/bge-m3
PAMA_EMBED_API_KEY=

# --- Backups (deploy/cloud/backup.sh) -------------------------------------------------------------
# Leave empty to keep dumps on the VM only (not recommended).
BACKUP_S3_URI=s3://my-pama-backups/db
BACKUP_KEEP_DAYS=14
